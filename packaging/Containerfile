# Build environment for the Steam Deck AppImage — used by
# scripts/build-in-container.sh. Mirrors .github/workflows/release.yml:
# Ubuntu 22.04 (glibc 2.35) so the result runs on SteamOS, plus the GStreamer
# plugins that get bundled into the AppImage (bundleMediaFramework).
FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl ca-certificates file git pkg-config \
      libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
      librsvg2-dev patchelf desktop-file-utils xvfb \
      libssl-dev libfuse2 squashfs-tools \
    && rm -rf /var/lib/apt/lists/*
# Node 20 (same as CI)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
# Rust stable
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"
WORKDIR /work
